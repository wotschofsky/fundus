# Public origin served by your external HTTPS reverse proxy. The Rust server is HTTP.
VAULT_PUBLIC_URL=https://vault.example.com
# Set proxy only when an authenticating reverse proxy protects all browser routes
# and clients cannot reach the origin directly. Upload/MCP routes still require tokens.
VAULT_AUTH_MODE=password
VAULT_RECORDER_TIMEZONE=UTC
# Required: transcription with speaker labels. Receives a 16 kHz rendition of each recording.
ASSEMBLYAI_API_KEY=
VAULT_TRANSCRIPTION_MODEL=universal-3-5-pro
# Languages the recordings code-switch between (comma-separated).
VAULT_TRANSCRIPTION_LANGUAGES=de,en
# Recommended: titles, summaries, name evidence and semantic search. Receives transcript text.
# Without a key, recordings show a warning instead of a summary and search uses keywords only.
OPENAI_API_KEY=
VAULT_TEXT_MODEL=gpt-6-luna
VAULT_EMBEDDING_MODEL=text-embedding-3-small
# Local binary only; Docker sets its own bind/data/web/model paths.
# VAULT_DATA_DIR=data
# VAULT_WEB_DIR=web/dist
# VAULT_BIND=127.0.0.1:3000
# VAULT_VOICE_MODEL=.cache/models/speaker-embedding.onnx
# ORT_DYLIB_PATH=/absolute/path/to/libonnxruntime.so.1.31.0
