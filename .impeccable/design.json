  "narrative": {
    "northStar": "Minimal white archive",
    "overview": "The web interface is minimalist, modern, and white. Neutral text, thin dividers, plain horizontal navigation, and generous whitespace keep the recording list and transcript central. Page headings name the task directly; compact metadata supports the content without becoming ornament.\n\nThis records the shipped Svelte web interface after the user's explicit white-interface direction superseded the earlier design. It establishes no native client tokens or architecture. The review screenshots contain synthetic demonstration content and provide web evidence only.",
    "keyCharacteristics": [
      "White page and control surfaces with neutral ink.",
      "Plain horizontal navigation that retains text labels on narrow screens.",
      "Divider-led rows with no decorative icon tiles or panels.",
      "Timestamp-linked audio beside spacious transcript prose."
    ],
    "rules": [
      {
        "name": "White Ground",
        "body": "Keep the archive on white; use neutral text and thin boundaries for hierarchy, with status color reserved for explicit problems and destructive actions.",
        "section": "colors"
      },
      {
        "name": "Divider",
        "body": "Use whitespace and fine dividers to organize archive content; preserve an open reading surface instead of adding decorative containers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep white as the page and control ground, using neutral type hierarchy and fine dividers.",
      "Do retain labeled navigation and visible keyboard focus on narrow web screens.",
      "Do preserve bounded, wrapping transcript prose and timestamp access to original audio.",
      "Do make errors, failed processing, and destructive actions explicit in words as well as color."
    ],
    "donts": [
      "Don't reintroduce warm backgrounds, green accents, decorative icon tiles, colored panels, gradients, or shadows.",
      "Don't replace open archive rows with ornamental cards or badges.",
      "Don't treat responsive web screenshots as native client or physical hardware validation."
    ]
  }
}
