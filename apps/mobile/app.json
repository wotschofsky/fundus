{
  "expo": {
    "name": "Fundus",
    "slug": "fundus-uploader",
    "scheme": "vault-uploader",
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.wsky.vaultuploader",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
